##------------- Venn Diagram: SCO vs. ROSI at Baseline ---------------##
# Load necessary libraries
library(dplyr)
library(openxlsx)

# ---------------------------
# Step 1: Filter for significant genes
# ---------------------------
SCO_sig <- SCOvsDMSO_Basal %>% 
  filter(adj.P.Val < 0.05)

ROSI_sig <- ROSIvsDMSO_Basal %>% 
  filter(adj.P.Val < 0.05)

# ---------------------------
# Step 2: Extract gene names and calculate shared/unique genes
# ---------------------------
SCO_genes <- SCO_sig %>% pull(gene_name)
ROSI_genes <- ROSI_sig %>% pull(gene_name)

shared_genes <- intersect(SCO_genes, ROSI_genes)
unique_SCO <- setdiff(SCO_genes, ROSI_genes)
unique_ROSI <- setdiff(ROSI_genes, SCO_genes)

# ---------------------------
# Step 3: Create data frames with desired columns
# For shared genes, merge the rows from each dataset by gene_name.
# ---------------------------
shared_data <- inner_join(
  SCO_sig %>% select(gene_name, logFC, adj.P.Val, B),
  ROSI_sig %>% select(gene_name, logFC, adj.P.Val, B),
  by = "gene_name",
  suffix = c("_SCO", "_ROSI")
)

# For unique genes, just filter the corresponding data.
unique_SCO_data <- SCO_sig %>% 
  filter(gene_name %in% unique_SCO) %>%
  select(gene_name, logFC, adj.P.Val, B)

unique_ROSI_data <- ROSI_sig %>% 
  filter(gene_name %in% unique_ROSI) %>%
  select(gene_name, logFC, adj.P.Val, B)

# ---------------------------
# Step 4: Write the data frames to an Excel file
# ---------------------------
wb <- createWorkbook()

addWorksheet(wb, "Shared Genes")
writeData(wb, sheet = "Shared Genes", x = shared_data)

addWorksheet(wb, "Unique to SCO")
writeData(wb, sheet = "Unique to SCO", x = unique_SCO_data)

addWorksheet(wb, "Unique to ROSI")
writeData(wb, sheet = "Unique to ROSI", x = unique_ROSI_data)

saveWorkbook(wb, file = "shared_unique_genes.xlsx", overwrite = TRUE)
