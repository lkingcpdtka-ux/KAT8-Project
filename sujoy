sample_info <- read.xlsx("dil_RNA_for_Genomics_Core_062524.xlsx")

## Extract the ensemble_id, gene_name and count data from the raw counts 
new_raw_counts <- raw_counts[, c(1,4, which(colnames(raw_counts) == "Sample_01"): which(colnames(raw_counts) == "Sample_32"))]

## Lets analyse the new raw counts data
any(is.na(new_raw_counts)) # check if there any NA values present in the raw counts data

which(is.na(new_raw_counts), arr.ind = TRUE) # check which rows and columns have the NA values 

any(new_raw_counts[,2] == "") # check if there any blank values in the gene_name column

## found NA values in the gene_name so we'll replace NA values in the gene_name column with values from the ensemble_gene_id column
new_raw_counts[, 2][is.na(new_raw_counts[, 2])] <- new_raw_counts[, 1][is.na(new_raw_counts[, 2])]

any(duplicated(new_raw_counts$gene_name)) # check if there any duplicate gene names

which(duplicated(new_raw_counts$gene_name), arr.ind = TRUE) # 235 gene names have duplicate values 

## found duplicate gene names so we'll concatenate those gene names with ensemble_gene_id values
dup_genes <- new_raw_counts[duplicated(new_raw_counts$gene_name), ] # add the duplicated genes data into a new df
dup_genes <-  dup_genes %>%                          # concatenate the gene name with the ensembl_id
  mutate(gene_name = paste0(ensembl_gene_id, "_", gene_name))

#replace the modified duplicated gene name values in the raw counts data
new_raw_counts$gene_name <- ifelse(
  rownames(new_raw_counts) %in% rownames(dup_genes),  # Check if row names match
  dup_genes$gene_name[match(rownames(new_raw_counts), rownames(dup_genes))],  # Replace with modified names
  new_raw_counts$gene_name  # Keep original name if no match
)

## create a DGE list 
new_raw_counts <- new_raw_counts[,-1]
DGE <- DGEList(counts = new_raw_counts)

## TMM normalization
DGE <- calcNormFactors(DGE)

## log2 transformation of count data and prior count = 3
logCPM <- cpm(DGE$counts, log = T, prior.count = 3) # logcpm values without gene names

logCPM_file <- data.frame(Gene = DGE$genes$gene_name, logCPM) #logcpm values with gene names

## add group data to DGE list
DGE$samples$group <- sample_info$Sample.key # replaced the group values in the DGE list with the actual group values from the sample data

# filter the low-quality genes
keep <- rowSums(cpm(DGE) >1) >= 16
DGE <- DGE[keep,,keep.lib.sizes = F]
length(rownames(DGE$counts)) #11798 genes remained after filtering

if (all(colnames(DGE$counts) == rownames(DGE$samples))) {
  
  # Extract group names
  group_names <- DGE$samples$group
  
  # Generate new colnames with sequential numbering
  new_colnames <- ave(group_names, group_names, FUN = function(x) paste0(x, "_", seq_along(x)))
  
  # Assign new column names
  colnames(DGE$counts) <- new_colnames
}

rownames(DGE$samples) <- colnames(DGE$counts)

