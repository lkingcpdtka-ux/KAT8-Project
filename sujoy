## PCA plot (Princpial Component Analysis)
data <- data.table(logCPM) # convert logcpm matrix to a data table obj
tdata <- data.table::transpose(data) # transpose the data table
colnames(tdata) <- DGE$genes$gene_name #set colnames of the transposed data
rownames(tdata) <- colnames(DGE$counts) #set rownames of the transposed data

pca <- prcomp(tdata, scale. = T) # pca on transposed data

##screeplot 
screeplot(pca)

## proportion of variance explained by each component
summary(pca)

# convert principal component values to a dataframe obj
pca_data <- data.frame(pca$x)

#Add the group values to pca df
pca_data$Group <- DGE$samples$group 

# Split the group column into two: 'Condition' and 'Group'
pca_data <- pca_data %>%
  mutate(Condition = sub("_.*", "", Group),    # Extract everything before the underscore for 'Condition'
         Group = sub(".*_", "", Group))  # Extract everything after the underscore for 'Group'

# Assign colors to groups
pca_groups <- unique(pca_data$Group)
colors_groups <- brewer.pal(length(pca_groups), "Set2")
pca_data$Color_groups <- colors_groups[as.numeric(factor(pca_data$Group, levels = pca_groups))]

# Plot PCA
#jpeg("PCA_Plot.jpeg", width = 2500, height = 1800, res = 300)
ggplot(data= pca_data, aes(x=PC1, y=PC2)) +
  geom_point(size=5, aes(color=Group, shape = Condition))+
  geom_hline(yintercept=0, colour="black", linetype="dashed") +
  geom_vline(xintercept=0, colour="black", linetype="dashed") +
  geom_text_repel(label= rownames(tdata), colour="black", size=3, nudge_x=0.1, nudge_y=0.1, max.overlaps = Inf) +  
  xlab("PC (40%)")+
  ylab("PC2(12%)")+ 
  theme(axis.text=element_text(size=14, colour="black"),axis.title=element_text(size=14, face="bold", colour="black")) + 
  theme(panel.background = element_rect(fill = "white", colour = 'black'))+
  ggtitle("PCA_plot")
#dev.off()

## Lets do a correlation test to see if the sample 9 of basal_CAP7 is related to other basal_CAP7 samples

# Extract expression data for CAP7 basal samples
cap7_basal_samples <- DGE$counts[, grepl("basal_CAP7", DGE$samples$group)]

# Compute pairwise correlation matrix
cap7_correlation <- cor(cap7_basal_samples, method = "pearson")

cap7_correlation #all basal_CAP7 samples are highly correlated!


## Differential gene expression analysis
group <- factor(sample_info$Sample.key) # factor the group data
group <- factor(group, levels = unique(group))

unpaired_data <- data.frame(Samplenames = colnames(DGE$counts), group = group)

#design matrix for unpaired analysis
design <- model.matrix(~0+group, data = unpaired_data)
colnames(design) <- gsub("group", "", colnames(design))
rownames(design) <- unpaired_data$Samplenames

## Contrast matrix
contr.matrix <- makeContrasts(
  # To identify treatment-specific effects within the basal condition
  SCO_vs_DMSO_basal = basal_SCO - basal_DMSO,
  CAP7_vs_DMSO_basal = basal_CAP7 - basal_DMSO,
  ROSI_vs_DMSO_basal = basal_ROSI - basal_DMSO,
  SCO_vs_ROSI_basal = basal_SCO - basal_ROSI,
  CAP7_vs_SCO_basal = basal_CAP7 - basal_SCO,
  ROSI_vs_CAP7_basal = basal_ROSI - basal_CAP7,
  
  # To identify treatment-specific effects within the TNF condition
  SCO_vs_DMSO_TNF = TNF_SCO - TNF_DMSO,
  CAP7_vs_DMSO_TNF = TNF_CAP7 - TNF_DMSO,
  ROSI_vs_DMSO_TNF = TNF_ROSI - TNF_DMSO,
  SCO_vs_ROSI_TNF = TNF_SCO - TNF_ROSI,
  CAP7_vs_SCO_TNF = TNF_CAP7 - TNF_SCO,
  ROSI_vs_CAP7_TNF = TNF_ROSI - TNF_CAP7,
  
  # To identify condition-specific comparisons (TNF vs Basal) per treatment
  ROSI_TNFvsBasal = TNF_ROSI - basal_ROSI,
  CAP7_TNFvsBasal = TNF_CAP7 - basal_CAP7,
  SCO_TNFvsBasal = TNF_SCO - basal_SCO,
  DMSO_TNFvsBasal = TNF_DMSO - basal_DMSO,
  levels = design)

## Run voom
v <- voom(DGE, design, plot = T)
fit <- lmFit(v, design)
fit <- contrasts.fit(fit, contr.matrix)
efit <- eBayes(fit)

# No fdr threshold was given to the following data - contains all genes

# Limma output for treatment vs DMSO vehicle (control) at baseline (i.e., absence of TNF-a)
SCOvsDMSO_Basal <-  topTable(efit, n = Inf, coef = 1, adjust.method = "fdr", sort.by = "P") 
CAP7vsDMSO_Basal <- topTable(efit, n = Inf, coef = 2, adjust.method = "fdr", sort.by = "P")
ROSIvsDMSO_Basal <- topTable(efit, n = Inf, coef = 3, adjust.method = "fdr", sort.by = "P")

# Limma output for treatment vs treatment at baseline (i.e., absence of TNF-a)
ROSIvsSCO_Basal <- topTable(efit, n = Inf, coef = 4, adjust.method = "fdr", sort.by = "P")
CAP7vsSCO_Basal <- topTable(efit, n = Inf, coef = 5, adjust.method = "fdr", sort.by = "P")
ROSIvsCAP7_Basal <- topTable(efit, n = Inf, coef = 6, adjust.method = "fdr", sort.by = "P")

# Limma output for treatment vs DMSO vehicle (control) at TNF (i.e., presence of TNF-a)
SCOvsDMSO_TNF <- topTable(efit, n = Inf, coef = 7, adjust.method = "fdr", sort.by = "P")
CAP7vsDMSO_TNF <- topTable(efit, n = Inf, coef = 8, adjust.method = "fdr", sort.by = "P")
ROSIvsDMSO_TNF <- topTable(efit, n = Inf, coef = 9, adjust.method = "fdr", sort.by = "P")

# Limma output for treatment vs treatment at TNF (i.e., presence of TNF-a)
ROSIvsSCO_TNF <- topTable(efit, n = Inf, coef = 10, adjust.method = "fdr", sort.by = "P")
CAP7vsSCO_TNF <- topTable(efit, n = Inf, coef = 11, adjust.method = "fdr", sort.by = "P")
ROSIvsCAP7_TNF <- topTable(efit, n = Inf, coef = 12, adjust.method = "fdr", sort.by = "P")

# Limma output for treatments at TNF (ie., presence of TNF-a) vs treatments at baseline (i.e., absence of TNF-a)
ROSI_TNFvsBasal <- topTable(efit, n = Inf, coef = 13, adjust.method = "fdr", sort.by = "P")
CAP7_TNFvsBasal <- topTable(efit, n = Inf, coef = 14, adjust.method = "fdr", sort.by = "P")
SCO_TNFvsBasal <- topTable(efit, n = Inf, coef = 15, adjust.method = "fdr", sort.by = "P")
