# Define a function to perform enrichment analysis
perform_enrichment <- function(gene_set, pathway_list, total_genes, set_name) {
  # Initialize the results table
  results <- data.frame(
    Term = character(),
    Overlap = character(),
    P.value = numeric(),
    Adjusted.P.value = numeric(),
    Odds.Ratio = numeric(),
    Combined.Score = numeric(),
    Genes = character(),
    stringsAsFactors = FALSE
  )
  
  # Iterate over pathways
  for (term in names(pathway_list)) {
    pathway_genes <- pathway_list[[term]]
    overlap_genes <- intersect(gene_set, pathway_genes) # genes that overlap between my gene set and within each pathway in KEGG gmt file
    overlap_size <- length(overlap_genes) # total no of genes overlapped between my gene set and that particular pathway
    
    # Skip pathways with no overlap
    if (overlap_size == 0) next
    
    pathway_size <- length(pathway_genes) #genes in each pathway in the KEGG gmt fil
    gene_set_size <- length(gene_set) # no of genes present in my gene set
    
    # Fisher's exact test
    fisher_table <- matrix(
      c(total_genes - (pathway_size + gene_set_size - overlap_size), # In neither
        pathway_size - overlap_size, # In pathway but not in gene set
        gene_set_size - overlap_size, # In gene set but not in pathway
        overlap_size), # Genes in both gene set and the pathway
      nrow = 2
    )
    fisher_result <- fisher.test(fisher_table, alternative = "greater")
    
    # Odds ratio and p-value
    odds_ratio <- fisher_result$estimate
    p_value <- fisher_result$p.value
    
    # Combine score: -log10(p-value) * odds ratio
    combined_score <- -log10(p_value) * odds_ratio
    
    # Append to results
    results <- rbind(results, data.frame(
      Term = term,
      Overlap = paste0(overlap_size, "/", pathway_size),
      P.value = p_value,
      Adjusted.P.value = NA,  # To be calculated later
      Odds.Ratio = odds_ratio,
      Combined.Score = combined_score,
      Genes = paste(overlap_genes, collapse = ", ")
    ))
  }
  
  # Adjust p-values using FDR
  results$Adjusted.P.value <- p.adjust(results$P.value, method = "fdr")
  
  # Sort by Adjusted.P.value
  results <- results[order(results$Adjusted.P.value), ]
  
  # Save the results to a file
  write.xlsx(results, file = paste0(set_name, ".xlsx"), rowNames = FALSE)
  
  return(results)
}

